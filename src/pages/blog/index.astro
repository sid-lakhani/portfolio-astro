---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const allBlogs = await getCollection("blogs");
const posts = allBlogs.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// Collect all unique tags
const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });
}
---

<BaseLayout
  title="Blog — Siddhesh Lakhani"
  description="Notes on code, Linux, building things, and whatever else I'm into."
  activePage="blog"
>
  <slot name="head" slot="head">
    <link rel="alternate" type="application/rss+xml" title="Siddhesh Lakhani Blog" href="/rss.xml" />
  </slot>

  <div class="page-wrap">
    <div class="blog-hero">
      <div class="grid-bg"></div>
      <div class="blog-hero-inner">
        <div class="section-tag">Writing</div>
        <h1 class="section-h">
          Blog &<br /><span style="color:var(--red)">Notes.</span>
        </h1>
        <p class="section-sub">
          Notes on code, Linux, building things, and whatever else I'm into.
        </p>
        <div class="hero-meta">
          <span class="hero-count">{posts.length} posts</span>
          <a href="/rss.xml" class="rss-link" title="Subscribe via RSS">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
              <path
                d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"
              ></path>
            </svg>
            RSS Feed
          </a>
        </div>
      </div>
    </div>

    <!-- TAG FILTER -->
    <div class="filter-bar">
      <button class="filter-btn active" onclick="filterPosts('all',this)">All</button>
      {allTags.map((tag) => (
        <button class="filter-btn" onclick={`filterPosts('${tag}',this)`}>{tag}</button>
      ))}
    </div>

    <!-- POST LIST -->
    <div class="posts-wrap">
      {posts.map((post) => (
        <div class="post-row" data-tags={post.data.tags.join(",")}>
          <a href={`/blog/${post.data.slug}`} class="post-card">
            <div class="post-card-left">
              <time class="post-date" datetime={post.data.date}>
                {formatDate(post.data.date)}
              </time>
            </div>
            <div class="post-card-body">
              <div class="post-card-top">
                {post.data.featured && (
                  <span class="post-featured-badge">Featured</span>
                )}
                <h2 class="post-title">{post.data.title}</h2>
              </div>
              <p class="post-desc">{post.data.description}</p>
              <div class="post-tags">
                {post.data.tags.map((tag) => (
                  <span class="proj-tag">{tag}</span>
                ))}
              </div>
            </div>
          </a>
        </div>
      ))}
    </div>

    {posts.length === 0 && (
      <div class="empty-state">
        <p>No posts yet — check back soon.</p>
      </div>
    )}

    <!-- RSS CTA -->
    <div class="rss-strip">
      <div class="cta-card">
        <div class="section-tag">Stay Updated</div>
        <h2 class="section-h">Subscribe via RSS.</h2>
        <p class="section-sub">
          No newsletter, no tracking. Copy the feed URL and drop it into your
          reader — Feedly, NetNewsWire, whatever you use.
        </p>
        <div class="cta-btns">
          <a href="/rss.xml" target="_blank" class="btn-primary">
            RSS Feed
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-left: 2px">
              <path d="M7 17L17 7" /><path d="M7 7h10v10" />
            </svg>
          </a>
          <a href="https://github.com/sid-lakhani" target="_blank" class="btn-outline">
            GitHub
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-left: 2px">
              <path d="M7 17L17 7" /><path d="M7 7h10v10" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* BLOG HERO */
  .blog-hero {
    padding: 120px 52px 60px;
    position: relative;
    overflow: hidden;
  }
  .blog-hero .grid-bg {
    opacity: 0.5;
  }
  .blog-hero-inner {
    position: relative;
    z-index: 2;
  }
  .blog-hero-inner .section-h {
    margin-top: 12px;
    max-width: 600px;
  }
  .blog-hero-inner .section-sub {
    max-width: 520px;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 24px;
  }
  .hero-count {
    font-size: 12px;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.05em;
  }
  .rss-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 600;
    color: var(--red);
    text-decoration: none;
    border: 1px solid var(--red-border);
    padding: 5px 12px;
    border-radius: 5px;
    background: var(--red-faint);
    transition: all 0.2s;
    letter-spacing: 0.04em;
  }
  .rss-link:hover {
    background: rgba(255, 59, 59, 0.14);
    border-color: var(--red);
  }

  /* FILTER PILLS */
  .filter-bar {
    padding: 0 52px 48px;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .filter-btn {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--char2);
    color: var(--muted);
    border: 1px solid var(--border);
    padding: 7px 16px;
    border-radius: 999px;
    cursor: pointer;
    transition: all 0.2s;
  }
  .filter-btn:hover,
  .filter-btn.active {
    background: var(--red-faint);
    color: var(--red);
    border-color: var(--red-border);
  }

  /* POST LIST */
  .posts-wrap {
    padding: 0 52px 64px;
    display: flex;
    flex-direction: column;
  }

  .post-row {
    border-bottom: 1px solid var(--border);
  }
  .post-row:first-child {
    border-top: 1px solid var(--border);
  }

  .post-card {
    display: grid;
    grid-template-columns: 160px 1fr;
    padding: 28px 0;
    text-decoration: none;
    color: inherit;
    position: relative;
  }
  .post-card::before {
    content: "";
    position: absolute;
    left: -52px;
    right: -52px;
    top: 0;
    bottom: 0;
    background: transparent;
    transition: background 0.18s;
    pointer-events: none;
  }
  .post-card:hover::before {
    background: rgba(255, 59, 59, 0.03);
  }

  .post-card-left {
    padding-right: 32px;
    padding-top: 4px;
    position: relative;
    z-index: 1;
  }
  .post-date {
    font-size: 12px;
    color: var(--muted);
    font-weight: 500;
    white-space: nowrap;
  }

  .post-card-body {
    position: relative;
    z-index: 1;
  }
  .post-card-top {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
    flex-wrap: wrap;
  }
  .post-featured-badge {
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--red);
    background: var(--red-faint);
    border: 1px solid var(--red-border);
    padding: 2px 8px;
    border-radius: 3px;
    flex-shrink: 0;
  }
  .post-title {
    font-family: "Syne", sans-serif;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--off);
    transition: color 0.2s;
  }
  .post-card:hover .post-title {
    color: var(--red);
  }
  .post-desc {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.65;
    margin-bottom: 14px;
    max-width: 640px;
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .proj-tag {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--red);
    background: rgba(255, 59, 59, 0.08);
    padding: 3px 9px;
    border-radius: 3px;
    border: 1px solid rgba(255, 59, 59, 0.15);
  }

  /* EMPTY STATE */
  .empty-state {
    padding: 80px 52px;
    text-align: center;
    color: var(--muted);
    font-size: 14px;
  }

  /* RSS STRIP */
  .rss-strip {
    padding: 0 52px 96px;
  }
  .cta-card {
    background: var(--char2);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 60px 48px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .cta-card .section-h {
    margin: 12px auto 16px;
    max-width: 800px;
  }
  .cta-card .section-sub {
    margin: 0 auto;
    max-width: 580px;
  }
  .cta-btns {
    margin-top: 36px;
    display: flex;
    gap: 16px;
    justify-content: center;
  }

  /* RESPONSIVE */
  @media (max-width: 700px) {
    .blog-hero,
    .filter-bar,
    .posts-wrap,
    .rss-strip {
      padding-left: 20px;
      padding-right: 20px;
    }
    .blog-hero {
      padding-top: 80px;
      padding-bottom: 40px;
    }
    .post-card {
      grid-template-columns: 1fr;
      gap: 8px;
      padding: 20px 0;
    }
    .post-card::before {
      left: -20px;
      right: -20px;
    }
    .post-card-left {
      padding-right: 0;
      padding-top: 0;
    }
    .post-title {
      font-size: 16px;
    }
    .cta-card {
      padding: 40px 24px;
    }
    .cta-btns {
      flex-direction: column;
      align-items: center;
    }
  }
</style>

<script is:inline>
  window.filterPosts = function (tag, btn) {
    document.querySelectorAll(".filter-btn").forEach((b) => b.classList.remove("active"));
    btn.classList.add("active");
    document.querySelectorAll(".post-row").forEach((row) => {
      const tags = row.dataset.tags || "";
      if (tag === "all" || tags.split(",").includes(tag)) {
        row.style.display = "block";
      } else {
        row.style.display = "none";
      }
    });
  };
</script>
